# --- LLM providers (any one; without keys the deterministic mock is used) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# fal.ai key for the Image/Video agents (https://fal.ai/dashboard/keys)
FAL_KEY=
# AIBOS_FAL_IMAGE_MODEL=fal-ai/flux/schnell
# AIBOS_FAL_VIDEO_MODEL=fal-ai/ltx-video

# Force the offline mock LLM even when keys are present (tests/demos)
AIBOS_MOCK_LLM=

# --- Database (default: local SQLite file; use Postgres in production) ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/aibos

# --- Safety rails (doc 8 §8.4) ---
AIBOS_MAX_AGENT_MESSAGES_DAY=500
AIBOS_MAX_AI_COST_DAY=50.0
