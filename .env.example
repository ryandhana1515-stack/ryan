# ─── OpenRouter (existing) ──────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Instagram ──────────────────────────────────────────────────
# Get these from Meta Developer Portal: https://developers.facebook.com
# Your Instagram account MUST be a Business or Creator account
# and must be linked to a Facebook Page.
#
# Steps:
#  1. Create a Meta App at developers.facebook.com
#  2. Add "Instagram Graph API" product
#  3. Generate a long-lived User Access Token with these permissions:
#     instagram_basic, instagram_content_publish, pages_read_engagement
#  4. Get your Instagram Business Account ID from the API
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token

# ─── Facebook Page ──────────────────────────────────────────────
# Same Meta App as above.
# Steps:
#  1. Call GET /me/accounts to list your Pages and get the Page ID + Page access token
#  2. Permissions needed: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# ─── TikTok ─────────────────────────────────────────────────────
# Get these from TikTok Developer Portal: https://developers.tiktok.com
# Steps:
#  1. Create an app and apply for "Content Posting API" access
#  2. Complete OAuth flow to get an access token for your account
#     (scope needed: video.publish, video.upload)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_CLIENT_KEY=your_tiktok_client_key
