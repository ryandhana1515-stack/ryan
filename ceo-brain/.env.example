# CEO Brain — environment variable NAMES only. Never put real values in this file.
# Copy to .env (git-ignored) when running anything locally.

# --- n8n (the orchestrator) ---
N8N_BASE_URL=                     # e.g. https://ryan1515.app.n8n.cloud
N8N_API_KEY=                      # only needed for scripted deploys outside the Claude MCP session
CEO_BRAIN_WEBHOOK_SECRET=         # Phase 2: shared secret for the lead webhook (header auth)

# --- AI providers (Phase 1 uses n8n Gateway credits; these are for self-managed keys) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Database (Phase 2; Phase 1 uses n8n Data Tables) ---
DATABASE_URL=                     # postgres://user:pass@host:5432/db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never in a browser or in n8n Code nodes

# --- Channels (Phase 2) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TIKTOK_LEADGEN_ACCESS_TOKEN=
RESPOND_IO_API_TOKEN=

# --- Google (Phase 2; Phase 1 email uses the n8n Gmail OAuth credential) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments / accounting (Phase 3+) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- Notifications ---
OWNER_NOTIFY_EMAIL=               # defaults to the value in agents/sales-qualification/agent.json
