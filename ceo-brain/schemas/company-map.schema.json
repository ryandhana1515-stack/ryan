{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceo-brain.local/schemas/company-map.schema.json",
  "title": "ClientDigitalCompanyMap",
  "description": "The Client Digital Company Map: the structured digital model of a customer's company that the Company Discovery & Onboarding Agent builds progressively from an ordinary conversation. Every value comes from the customer's words or is null/empty. It is the blueprint for that customer's CEO Brain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_profile", "customers", "sales_process", "marketing", "communication_channels", "current_software", "operations_process", "customer_service", "finance_process", "people_roles", "management", "automation", "data_sources", "pain_points", "automation_opportunities", "integration_requirements", "security_requirements", "ceo_reporting_requirements", "proposed_modules", "proposed_agents"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "company_profile": { "type": "object", "additionalProperties": false, "required": ["company_name", "brand_name", "industry", "locations", "markets", "products", "services", "employees", "departments", "management_structure"],
      "properties": { "company_name": { "type": ["string", "null"] }, "brand_name": { "type": ["string", "null"] }, "industry": { "type": ["string", "null"] }, "locations": { "type": "array", "items": { "type": "string" } }, "markets": { "type": "array", "items": { "type": "string" } }, "products": { "type": "array", "items": { "type": "string" } }, "services": { "type": "array", "items": { "type": "string" } }, "employees": { "type": ["integer", "null"] }, "departments": { "type": "array", "items": { "type": "string" } }, "management_structure": { "type": ["string", "null"] } } },
    "customers": { "type": "object", "additionalProperties": false, "required": ["who_buys", "business_model", "typical_customer", "segments", "journey", "repeat_customers", "existing_database"],
      "properties": { "who_buys": { "type": ["string", "null"] }, "business_model": { "type": ["string", "null"], "enum": ["B2B", "B2C", "both", null] }, "typical_customer": { "type": ["string", "null"] }, "segments": { "type": "array", "items": { "type": "string" } }, "journey": { "type": ["string", "null"] }, "repeat_customers": { "type": ["boolean", "null"] }, "existing_database": { "type": ["string", "null"], "description": "Where the customer list lives today (Excel, CRM, WhatsApp, nowhere)" } } },
    "sales_process": { "type": "object", "additionalProperties": false, "required": ["lead_sources", "lead_receiver", "response_time", "follow_up_owner", "follow_up_count", "quotation_process", "deal_tracking", "where_leads_lost", "qualified_lead_definition", "hot_lead_definition"],
      "properties": { "lead_sources": { "type": "array", "items": { "type": "string" } }, "lead_receiver": { "type": ["string", "null"] }, "response_time": { "type": ["string", "null"] }, "follow_up_owner": { "type": ["string", "null"] }, "follow_up_count": { "type": ["string", "null"] }, "quotation_process": { "type": ["string", "null"] }, "deal_tracking": { "type": ["string", "null"] }, "where_leads_lost": { "type": ["string", "null"] }, "qualified_lead_definition": { "type": ["string", "null"] }, "hot_lead_definition": { "type": ["string", "null"] } } },
    "marketing": { "type": "object", "additionalProperties": false, "required": ["channels", "agencies", "content_production", "lead_forms"],
      "properties": { "channels": { "type": "array", "items": { "type": "string", "enum": ["facebook", "instagram", "tiktok", "google", "youtube", "website", "seo", "email_marketing", "linkedin", "referrals", "events", "other"] } }, "agencies": { "type": ["string", "null"] }, "content_production": { "type": ["string", "null"] }, "lead_forms": { "type": ["string", "null"] } } },
    "communication_channels": { "type": "array", "items": { "type": "string", "enum": ["whatsapp", "whatsapp_business", "email", "phone", "sms", "website_chat", "social_dm", "telegram", "other"] } },
    "current_software": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "category", "notes"],
      "properties": { "name": { "type": "string" }, "category": { "type": "string", "enum": ["crm", "erp", "accounting", "pos", "booking", "spreadsheets", "google_workspace", "microsoft_365", "cloud_storage", "industry_specific", "internal_app", "messaging", "ecommerce", "other"] }, "notes": { "type": ["string", "null"] } } } },
    "operations_process": { "type": "object", "additionalProperties": false, "required": ["work_intake", "who_performs", "task_assignment", "deadline_tracking", "approvals", "delays"],
      "properties": { "work_intake": { "type": ["string", "null"] }, "who_performs": { "type": ["string", "null"] }, "task_assignment": { "type": ["string", "null"] }, "deadline_tracking": { "type": ["string", "null"] }, "approvals": { "type": ["string", "null"] }, "delays": { "type": ["string", "null"] } } },
    "customer_service": { "type": "object", "additionalProperties": false, "required": ["channels", "responder", "common_questions", "complaints", "refund_process", "escalations"],
      "properties": { "channels": { "type": "array", "items": { "type": "string" } }, "responder": { "type": ["string", "null"] }, "common_questions": { "type": "array", "items": { "type": "string" } }, "complaints": { "type": ["string", "null"] }, "refund_process": { "type": ["string", "null"] }, "escalations": { "type": ["string", "null"] } } },
    "finance_process": { "type": "object", "additionalProperties": false, "required": ["accounting_software", "invoicing", "quotations", "payment_collection", "expenses", "outstanding_followup"],
      "properties": { "accounting_software": { "type": ["string", "null"] }, "invoicing": { "type": ["string", "null"] }, "quotations": { "type": ["string", "null"] }, "payment_collection": { "type": ["string", "null"] }, "expenses": { "type": ["string", "null"] }, "outstanding_followup": { "type": ["string", "null"] } } },
    "people_roles": { "type": "object", "additionalProperties": false, "required": ["departments", "roles", "approval_hierarchy", "task_allocation", "internal_comms", "onboarding", "sops"],
      "properties": { "departments": { "type": "array", "items": { "type": "string" } }, "roles": { "type": "array", "items": { "type": "string" } }, "approval_hierarchy": { "type": ["string", "null"] }, "task_allocation": { "type": ["string", "null"] }, "internal_comms": { "type": ["string", "null"] }, "onboarding": { "type": ["string", "null"] }, "sops": { "type": ["string", "null"] } } },
    "management": { "type": "object", "additionalProperties": false, "required": ["daily_checks", "reports_received", "hard_to_get_info", "slow_decisions", "surprises"],
      "properties": { "daily_checks": { "type": "array", "items": { "type": "string" } }, "reports_received": { "type": "array", "items": { "type": "string" } }, "hard_to_get_info": { "type": "array", "items": { "type": "string" } }, "slow_decisions": { "type": "array", "items": { "type": "string" } }, "surprises": { "type": "array", "items": { "type": "string" } } } },
    "automation": { "type": "object", "additionalProperties": false, "required": ["repeated_daily", "copy_paste", "forgotten", "too_long", "customers_repeat_ask", "wish_automatic"],
      "properties": { "repeated_daily": { "type": "array", "items": { "type": "string" } }, "copy_paste": { "type": "array", "items": { "type": "string" } }, "forgotten": { "type": "array", "items": { "type": "string" } }, "too_long": { "type": "array", "items": { "type": "string" } }, "customers_repeat_ask": { "type": "array", "items": { "type": "string" } }, "wish_automatic": { "type": "array", "items": { "type": "string" } } } },
    "data_sources": { "type": "array", "description": "The Data Discovery Checklist: where information lives today and how the CEO Brain should treat it.",
      "items": { "type": "object", "additionalProperties": false, "required": ["category", "availability", "source_system", "owner", "format", "approx_volume", "sensitivity", "import_method", "authorization_required", "handling"],
        "properties": {
          "category": { "type": "string", "enum": ["customer_records", "lead_records", "sales_records", "product_service_info", "pricing", "faqs", "sops", "documents", "templates", "policies", "past_quotations", "contracts", "marketing_materials", "website_content", "email", "calendars", "project_info", "operational_spreadsheets", "accounting_platform", "support_info", "employee_roles"] },
          "availability": { "type": "string", "enum": ["AVAILABLE", "NOT_AVAILABLE", "UNKNOWN", "CONNECTION_REQUIRED", "IMPORT_REQUIRED", "NOT_REQUIRED"] },
          "source_system": { "type": ["string", "null"] }, "owner": { "type": ["string", "null"] }, "format": { "type": ["string", "null"] }, "approx_volume": { "type": ["string", "null"] },
          "sensitivity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
          "import_method": { "type": ["string", "null"] }, "authorization_required": { "type": ["boolean", "null"] },
          "handling": { "type": ["string", "null"], "enum": ["CONNECTED_LIVE", "IMPORTED", "INDEXED", "SUMMARIZED", "LEFT_IN_PLACE", null], "description": "Connect, don't copy everything: live systems are connected, spreadsheets imported, SOPs indexed, procedures summarized, the rest left where it is" }
        } } },
    "pain_points": { "type": "array", "items": { "type": "string" } },
    "automation_opportunities": { "type": "array", "items": { "type": "string" } },
    "integration_requirements": { "type": "array", "items": { "type": "string" } },
    "security_requirements": { "type": "array", "items": { "type": "string" } },
    "ceo_reporting_requirements": { "type": "array", "items": { "type": "string" } },
    "proposed_modules": { "type": "array", "items": { "type": "string", "enum": ["ceo_dashboard", "sales_brain", "marketing_brain", "customer_service_brain", "operations_brain", "project_brain", "finance_information_brain", "admin_brain", "knowledge_brain", "reporting_brain"] } },
    "proposed_agents": { "type": "array", "items": { "type": "string", "enum": ["company_discovery", "sales", "solution_architect", "website_architect", "sme_website_builder", "medical_website_builder", "customer_service", "email_admin", "marketing", "operations", "finance_assistant", "ceo_intelligence"] } }
  }
}
