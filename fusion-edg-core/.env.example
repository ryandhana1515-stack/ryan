# Names only. Put values in .env.local (never committed) or the platform's secret manager.
# Development
DATABASE_URL=
TEST_DATABASE_URL=
# App role used for Row Level Security checks (created by the migrations; password set by scripts/dev-db.sh)
APP_DATABASE_URL=
TEST_APP_DATABASE_URL=
# Supabase (staging/production; service-role key is server-side only, never in the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Messaging / email / AI providers (per client, per environment)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
RESPOND_IO_TOKEN=
EMAIL_PROVIDER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Automation / deploy
N8N_BASE_URL=
N8N_API_KEY=
VERCEL_TOKEN=
# Accounting (only when the client uses it)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Runtime
EDG_ENV=development
EDG_WEBHOOK_SECRET=
