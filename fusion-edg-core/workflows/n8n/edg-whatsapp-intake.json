{
  "id": "edg-whatsapp-intake",
  "name": "EDG — WhatsApp Intake (forward provider webhook)",
  "nodes": [
    {
      "id": "b602ed90-ffd1-5c43-a4a4-e18a722e1301",
      "name": "Receive",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "edg/whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "1c2f63d3-0a68-5e60-a7c1-675785846e9c"
    },
    {
      "id": "0acf0420-a40d-508c-a3bd-2988d808f79b",
      "name": "EDG Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "api",
              "name": "edg_api_url",
              "value": "https://edg-api.example.invalid",
              "type": "string"
            },
            {
              "id": "org",
              "name": "org",
              "value": "acme-demo",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "92465975-ddea-55d5-a385-63cafd16e5c3",
      "name": "Forward to EDG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('EDG Config').item.json.edg_api_url }}/api/o/{{ $('EDG Config').item.json.org }}/webhooks/whatsapp/forwarded",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Receive').item.json.body) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "d013d0f9-a586-5de2-ad80-644c2cee7b81",
      "name": "Ack 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "819d2a2c-e014-514f-a43d-3df25496b49f",
      "name": "EDG Unavailable (provider retries)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false }) }}",
        "options": {
          "responseCode": 503
        }
      }
    }
  ],
  "connections": {
    "Receive": {
      "main": [
        [
          {
            "node": "EDG Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "EDG Config": {
      "main": [
        [
          {
            "node": "Forward to EDG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to EDG": {
      "main": [
        [
          {
            "node": "Ack 200",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "EDG Unavailable (provider retries)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}
