{
  "id": "edg-lead-assignment",
  "name": "EDG — Lead Assignment (sub-workflow, round-robin)",
  "nodes": [
    {
      "id": "d88ff358-ef19-500a-af88-15cc0a3faa59",
      "name": "Called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "lead_id",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "7d680566-b2da-5634-a7c9-a841f9151f43",
      "name": "EDG Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "api",
              "name": "edg_api_url",
              "value": "https://edg-api.example.invalid",
              "type": "string"
            },
            {
              "id": "org",
              "name": "org",
              "value": "acme-demo",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "6010a4b8-7f73-598b-a727-47acc71de8bb",
      "name": "Assign Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('EDG Config').item.json.edg_api_url }}/api/o/{{ $('EDG Config').item.json.org }}/leads/assign",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $('Called by another workflow').item.json.lead_id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "13a8f734-a603-591c-ae1d-63dcf59a5125",
      "name": "Fail Loudly",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        420
      ],
      "parameters": {
        "errorMessage": "EDG lead assignment failed"
      }
    }
  ],
  "connections": {
    "Called by another workflow": {
      "main": [
        [
          {
            "node": "EDG Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "EDG Config": {
      "main": [
        [
          {
            "node": "Assign Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assign Lead": {
      "main": [
        [],
        [
          {
            "node": "Fail Loudly",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}
