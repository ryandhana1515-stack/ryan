{
  "id": "edg-lead-deduplication",
  "name": "EDG — Lead Deduplication check (sub-workflow)",
  "nodes": [
    {
      "id": "b4fc0c2d-e6d8-563b-a667-ea04279fc2f2",
      "name": "Called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "phone",
              "type": "string"
            },
            {
              "name": "email",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "56f64ba5-9c60-5ba5-ae53-11113246b7fe",
      "name": "EDG Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "api",
              "name": "edg_api_url",
              "value": "https://edg-api.example.invalid",
              "type": "string"
            },
            {
              "id": "org",
              "name": "org",
              "value": "acme-demo",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "98a51287-014d-5283-ac8a-845767f2d9b8",
      "name": "Dedupe Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('EDG Config').item.json.edg_api_url }}/api/o/{{ $('EDG Config').item.json.org }}/dedupe-check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $('Called by another workflow').item.json.phone, email: $('Called by another workflow').item.json.email }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "876da3c8-3bb7-570f-a4f0-a6f693349b27",
      "name": "Fail Loudly",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        420
      ],
      "parameters": {
        "errorMessage": "EDG dedupe check failed"
      }
    }
  ],
  "connections": {
    "Called by another workflow": {
      "main": [
        [
          {
            "node": "EDG Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "EDG Config": {
      "main": [
        [
          {
            "node": "Dedupe Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dedupe Check": {
      "main": [
        [],
        [
          {
            "node": "Fail Loudly",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}
