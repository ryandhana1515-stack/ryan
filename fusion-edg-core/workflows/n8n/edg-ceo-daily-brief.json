{
  "id": "edg-ceo-daily-brief",
  "name": "EDG — CEO Daily Brief (weekdays 08:00, set workflow timezone to the client)",
  "nodes": [
    {
      "id": "53631514-9d2f-5519-a1fe-524bdd4c9ce4",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "798413b0-ec4a-59b4-a2ad-d02ca98144c1",
      "name": "EDG Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "api",
              "name": "edg_api_url",
              "value": "https://edg-api.example.invalid",
              "type": "string"
            },
            {
              "id": "org",
              "name": "org",
              "value": "acme-demo",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "855bba3c-b466-5a72-aafc-ee6a8a3d41bc",
      "name": "Build + Deliver Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('EDG Config').item.json.edg_api_url }}/api/o/{{ $('EDG Config').item.json.org }}/jobs/ceo-brief",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ triggered_at: $now.toISO() }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "d06eb3ef-a422-52ca-aefb-2db722702872",
      "name": "Fail Loudly",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        420
      ],
      "parameters": {
        "errorMessage": "CEO brief job failed after retries"
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "EDG Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "EDG Config": {
      "main": [
        [
          {
            "node": "Build + Deliver Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build + Deliver Brief": {
      "main": [
        [],
        [
          {
            "node": "Fail Loudly",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}
